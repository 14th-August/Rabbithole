# Copy to .env and fill in from the Supabase dashboard (Settings -> API).
# Both values are safe to ship in the client bundle; RLS is what protects data.
# Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable key>

# SMTP relay for auth email. Read by supabase/config.toml via env(), NOT by the
# app — no EXPO_PUBLIC_ prefix, so it never reaches the client bundle.
# Create at resend.com/api-keys with "Sending access". Leave unset to fall back
# to the local Mailpit catcher on :54324.
RESEND_API_KEY=re_<sending key>
